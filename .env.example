# Server port
PORT=3000

# Where SQLite stores its data file. Defaults to <repo>/data when unset.
# Deployments MUST point this at a persistent volume (see render.yaml /
# DEPLOYMENT.md) or the database is wiped on every restart.
# DATA_DIR=/data

# Option 1 - single URL (cloudinary://API_KEY:API_SECRET@CLOUD_NAME)
# Copy it from: Dashboard > Account Details > Environment Variable
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Option 2 - individual settings (used when CLOUDINARY_URL is not set)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# ---- Gmail OTP auth module ----
# Brand name shown in the OTP email + login UI
APP_NAME=Intelligent Image Upload System

# Email transport. "gmail" = real delivery via Gmail SMTP (needs an App
# Password below). "json" = offline convenience transport that renders the
# email into memory (never sends) — ideal for local development.
EMAIL_TRANSPORT=json

# Gmail SMTP credentials (only needed when EMAIL_TRANSPORT=gmail).
# Use a Google "App Password", NOT your real Gmail password:
# https://myaccount.google.com/apppasswords (requires 2-Step Verification)
# GMAIL_USER=your-sending-address@gmail.com
# GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# If true, only @gmail.com / @googlemail.com addresses are accepted.
GMAIL_ONLY=true

# OTP behavior
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=45
OTP_MAX_REQUESTS_PER_WINDOW=5
OTP_REQUEST_WINDOW_MINUTES=15

# Secrets — generated with: openssl rand -hex 32. NEVER commit the real
# values; dev-only defaults are fine for local testing but must be replaced
# in production.
OTP_HASH_SECRET=change-this-to-a-long-random-string
JWT_SECRET=change-this-to-a-different-long-random-string
JWT_EXPIRES_IN=15m

# Session cookie
USE_COOKIE_SESSION=true
COOKIE_NAME=otp_auth_session
COOKIE_SAMESITE=lax

# CORS origin(s), comma-separated, only needed when calling this API
# cross-origin. Same-origin (server serves the frontend) needs nothing.
# CORS_ORIGIN=http://localhost:3000

# Set to "production" when deploying so helmet/secure cookies harden the app.
# NODE_ENV=production

# Optional: set "true" (or a proxy subnet) when running behind a reverse
# proxy (Render, Railway, nginx, Cloudflare) so per-IP rate limiting and
# x-forwarded-for behave correctly.
# TRUST_PROXY=true
